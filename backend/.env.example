OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Cheap + fast model for research (tool calling, web lookups)
RESEARCH_MODEL=deepseek/deepseek-v4-flash
# Email writer. Flash is ~10x cheaper than deepseek/deepseek-v4-pro and nearly as good here
WRITER_MODEL=deepseek/deepseek-v4-flash
# Results per OpenRouter web search (each result costs ~$0.004)
WEB_SEARCH_RESULTS=5
# How many leads to process in parallel
MAX_PARALLEL_LEADS=3
# Days between touches: first follow-up, second follow-up
FOLLOW_UP_DAYS=3,4

# Skip CrewAI cloud tracing prompts
CREWAI_TRACING_ENABLED=false
# Max web searches per lead (each ~$0.02 and 10-30s)
WEB_SEARCH_BUDGET=4

# Logins. Admin can import, research, and delete; the sender can only view,
# rewrite, open in Gmail, and mark sent.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
SENDER_EMAIL=sender@example.com
SENDER_PASSWORD=change-me
# Any long random string; changing it logs everyone out.
SESSION_SECRET=change-me-to-a-long-random-string

# basic = Apollo data + practice website, no web searches (cheapest). deep = adds web-search research agent.
RESEARCH_MODE=basic
# openrouter, or deepseek to call the DeepSeek API directly (then set DEEPSEEK_API_KEY)
LLM_PROVIDER=openrouter

# Code for the Apollo duplicate-checker Chrome extension (any random string)
EXTENSION_TOKEN=change-me
